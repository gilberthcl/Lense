# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=lens
POSTGRES_PASSWORD=lens_dev_change_me
POSTGRES_DB=lens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────────────────
# Generate a real secret for anything beyond local dev:  openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Max upload size per CSV (bytes). Methodology caps datasets at 20 MB.
MAX_UPLOAD_BYTES=20971520
# Dev convenience: auto-create tables on startup. Set false in production and
# manage the schema with Alembic instead (cd backend && alembic upgrade head).
DB_AUTO_CREATE=true

# ── Ollama (runs on the host, never in a container for this build) ─────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYST_MODEL=gemma3:27b
OLLAMA_REVIEWER_MODEL=gpt-oss:20b
OLLAMA_QA_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Request timeout for a single model call (seconds)
OLLAMA_TIMEOUT=600
