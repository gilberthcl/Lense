# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=lens
POSTGRES_PASSWORD=lens_dev_change_me
POSTGRES_DB=lens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────────────────
# Generate a real secret for anything beyond local dev:  openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Max upload size per CSV (bytes). Methodology caps datasets at 20 MB.
MAX_UPLOAD_BYTES=20971520
# Dev convenience: auto-create tables on startup. Set false in production and
# manage the schema with Alembic instead (cd backend && alembic upgrade head).
DB_AUTO_CREATE=true

# ── Ollama (runs on the host Mac, never in a container for this build) ──────
# Local-only + Western-origin / verified-provenance models ONLY. Never route
# client data through *-cloud models or unverified community fine-tunes — both
# break local-only compliance and tenant isolation.
OLLAMA_BASE_URL=http://localhost:11434

# Recommended compliant stack on a 32 GB Mac (run models one at a time):
OLLAMA_ANALYST_MODEL=gemma3:27b          # Google,  ~17 GB  (primary analyst)
OLLAMA_REVIEWER_MODEL=gpt-oss:20b        # OpenAI,  ~13 GB  (senior reviewer)
OLLAMA_QA_MODEL=gpt-oss:20b              # OpenAI,  ~13 GB  (report QA)
OLLAMA_EMBED_MODEL=nomic-embed-text      # Nomic/US, ~0.3 GB (REQUIRED for RAG; 768-dim)

# Strong Western alternative (Mistral AI, France, ~14 GB) — swap in as analyst or
# reviewer to A/B against gemma3/gpt-oss:
#   OLLAMA_ANALYST_MODEL=mistral-small:24b
# Heavier, only if you have RAM headroom (NVIDIA, ~42 GB — will swap on 32 GB):
#   OLLAMA_ANALYST_MODEL=nemotron:latest

# Request timeout for a single model call (seconds)
OLLAMA_TIMEOUT=600
